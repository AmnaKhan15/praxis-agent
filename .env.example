# Copy this file to ".env" and fill in ONE provider. Never commit ".env".

# Which brain to use: gemini | groq | openrouter | anthropic | demo
LLM_PROVIDER=gemini

# Free key (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Other optional providers
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the model name (model names change, check the provider's docs)
AGENT_MODEL=

# Optional: how many live runs per day the public demo may spend on YOUR key
DAILY_RUN_CAP=20
