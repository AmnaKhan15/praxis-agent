# Keep keys and clutter out of the image.
.env
.env.*
!.env.example
.git
.github
.venv
venv
__pycache__
*.pyc
.pytest_cache

# Not needed to run the app
tests
docs
*.md
!README.md
Dockerfile
.dockerignore
docker-compose.yml
